# Copy to .env.local and fill in. .env.local is git-ignored.
#
# NOTE: on a static build these values are compiled into the JS bundle
# and are readable by anyone who opens DevTools. Keeping them out of Git
# is worth doing, but it is not a substitute for a real backend.
# See docs/SECURITY.md.

# Bootstrap admin account, created the first time the app runs in a
# given browser. The password must be changed on first sign-in, after
# which this value stops working for that browser.
VITE_ADMIN_EMAIL=support@successcollege.co.il
VITE_ADMIN_PASSWORD=change-me-before-deploy

# Base path for GitHub Pages project sites (e.g. /infinix-Simulator/).
# Leave unset for user/org pages served from the domain root, and for
# Vercel.
# VITE_BASE_PATH=/infinix-Simulator/

# ── Shared question bank (Vercel) ────────────────────────────────
# Gates PUT/DELETE on /api/question-bank — the endpoint that publishes
# one question bank for every student. Deliberately has NO VITE_
# prefix: it must stay server-side, because unlike the sign-in gate
# this is a check the browser cannot reach or bypass.
#
# Generate one with:  openssl rand -base64 32
# Set it in Vercel under Project → Settings → Environment Variables.
ADMIN_UPLOAD_TOKEN=

# BLOB_READ_WRITE_TOKEN is NOT set by hand. Vercel injects it once you
# create a Blob store under Project → Storage. Without it the app still
# runs — /api/question-bank just reports that nothing is published and
# every visitor falls back to the bundled JSON.
