# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Accounts live on the server (api/auth.ts). The values below are read
# by the server only; the client never references them, so they do not
# end up in the JS bundle. See docs/SECURITY.md.

# Signs session tokens and encrypts the user list. Any long random
# string; changing it signs everyone out and starts an empty user list.
# Optional in local dev (a fixed dev value is used).
AUTH_SECRET=

# Support admin seed. Becomes a stored account the first time someone
# signs in with it, and must change its password on that first sign-in.
VITE_ADMIN_EMAIL=support@successcollege.co.il
VITE_ADMIN_PASSWORD=change-me-before-deploy

# There is no shared student login: every student has an account of
# their own, created by a manager (and, later, from the LMS).

# A manager for the college's own staff. Becomes a stored account on
# its first sign-in; after that the stored password is the one that counts.
MANAGER_EMAIL=
MANAGER_PASSWORD=

# Base path for GitHub Pages project sites (e.g. /infinix-Simulator/).
# Leave unset for user/org pages served from the domain root, and for
# Vercel.
# VITE_BASE_PATH=/infinix-Simulator/

# ── Shared question bank (Vercel) ────────────────────────────────
# Gates PUT/DELETE on /api/question-bank — the endpoint that publishes
# one question bank for every student. Deliberately has NO VITE_
# prefix: it must stay server-side, because unlike the sign-in gate
# this is a check the browser cannot reach or bypass.
#
# Generate one with:  openssl rand -base64 32
# Set it in Vercel under Project → Settings → Environment Variables.
ADMIN_UPLOAD_TOKEN=

# BLOB_READ_WRITE_TOKEN is NOT set by hand. Vercel injects it once you
# create a Blob store under Project → Storage. Without it the app still
# runs — /api/question-bank just reports that nothing is published and
# every visitor falls back to the bundled JSON.
